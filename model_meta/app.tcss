/* Application-level styles for Model Meta. */

/* The shared config vocabulary. The dashboard and the per-section detail
   screens render the same kinds of line — a heading, a configured value, a
   muted sub-detail — so these are app-level classes rather than per-screen
   copies. */
.section-title {
    text-style: bold;
    color: $accent;
}

.config-value {
    width: 100%;
}

.config-detail {
    color: $text-muted;
}

/* Shown in place of the sections when there is no valid config. */
#setup-prompt {
    width: auto;
    padding: 1 2;
}

/* -- dashboard ----------------------------------------------------------- */

/* A top-aligned column of config sections (Blender → Models → Godot), not a
   single centered line. */
DashboardScreen #config-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Sections are focusable cards (SectionCard): arrow keys move between them and
   enter opens one. The left rail is painted on *every* card, not just the
   focused one, so only its color changes with focus — a border that appeared on
   focus would shift the row's text sideways as the user moved through. */
DashboardScreen .section {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    border-left: thick $panel;
    padding-left: 1;
}

DashboardScreen .section:focus {
    border-left: thick $accent;
    background: $boost;
}

/* -- detail screens ------------------------------------------------------ */

#detail-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Sets the placeholder note apart from the values above it. */
#placeholder-note {
    margin-top: 1;
}

/* -- model dashboard screen ---------------------------------------------- */

ModelDashboardScreen #model-header {
    height: auto;
    margin-bottom: 1;
}

ModelDashboardScreen #model-heading {
    height: auto;
}

ModelDashboardScreen #model-title {
    width: auto;
}

ModelDashboardScreen #connection-status {
    width: auto;
    margin-left: 1;
}

ModelDashboardScreen #connection-hint {
    display: none;
}

ModelDashboardScreen .model-item-depth-1 {
    padding-left: 3;
}

ModelDashboardScreen .model-item-depth-2 {
    padding-left: 6;
}

/* -- spec detail screen -------------------------------------------------- */

/* One box per spec root field (FieldSummary); the field name sits in the border. */
SpecDetailScreen #spec-title {
    margin-bottom: 1;
}

SpecDetailScreen .field-summary {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

SpecDetailScreen .field-row-child {
    padding-left: 2;
}

/* Item lists (e.g. mesh role names) wrap into side-by-side columns. */
SpecDetailScreen .field-columns {
    height: auto;
}

SpecDetailScreen .field-column {
    width: auto;
    height: auto;
    margin-right: 4;
}

SpecDetailScreen .field-item {
    width: auto;
}

SpecDetailScreen .field-empty {
    color: $text-muted;
}

/* -- Specs screen -------------------------------------------------------- */

SpecsScreen #specs-summary,
SpecsScreen #specs-empty {
    margin-bottom: 1;
}

/* Spec rows are focusable, so — as on the dashboard and the Models screen —
   the rail is painted on every row and only its color changes, keeping the
   text from shifting sideways as focus moves. */
SpecsScreen .spec-row {
    width: 100%;
    height: auto;
    border-left: thick $panel;
    padding-left: 1;
}

SpecsScreen .spec-row:focus {
    border-left: thick $accent;
    background: $boost;
}

SpecsScreen .fix-step {
    width: 100%;
    height: auto;
}

/* The spec list scrolls; `height: 1fr` gives it whatever is left between the
   header, the fix block, and the footer. `can_focus=False` on the container
   (set in Python) keeps it out of the row focus chain. */
SpecsScreen #detail-panel {
    height: 1fr;
}

/* Sibling of the 1fr scroller, not docked: a docked container with auto height
   renders at one row. Capped so it can't crowd out the list. */
SpecsScreen #fix-panel {
    width: 100%;
    height: auto;
    max-height: 50%;
    padding: 0 2;
    border-top: solid $panel;
}

/* -- Models screen ------------------------------------------------------- */

ModelsScreen #models-summary {
    margin-bottom: 1;
}

ModelsScreen .models-group {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

ModelsScreen .models-directory {
    text-style: bold;
}

ModelsScreen .models-files {
    width: 100%;
    height: auto;
}

/* Model rows are focusable, so — as on the dashboard — the rail is painted on
   every row and only its color changes, keeping the text from shifting
   sideways as focus moves. */
ModelsScreen .model-row {
    width: 100%;
    height: auto;
    border-left: thick $panel;
    padding-left: 1;
}

ModelsScreen .model-row:focus {
    border-left: thick $accent;
    background: $boost;
}

ModelsScreen .fix-step {
    width: 100%;
    height: auto;
}

/* The model list scrolls; `height: 1fr` gives it whatever is left between the
   header, the docked fix block, and the footer. `can_focus=False` on the
   container (set in Python) keeps it out of the row focus chain. */
ModelsScreen #detail-panel {
    height: 1fr;
}

/* Sibling of the 1fr scroller, not docked: a docked container with auto height
   renders at one row. Capped so it can't crowd out the list. */
ModelsScreen #fix-panel {
    width: 100%;
    height: auto;
    max-height: 50%;
    padding: 0 2;
    border-top: solid $panel;
}

/* -- armature, mesh-roles, mesh-role and modifiers forms ----------------- */

/* One box per field (FieldList); the border turns accent when it's selected. */
ArmatureFormScreen .field-list, MeshRolesFormScreen .field-list,
MeshRoleFormScreen .field-list, ModifiersFormScreen .field-list {
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

ArmatureFormScreen .field-list:focus, MeshRolesFormScreen .field-list:focus,
MeshRoleFormScreen .field-list:focus, ModifiersFormScreen .field-list:focus {
    border: round $accent;
}

ArmatureFormScreen .field-list-child, MeshRolesFormScreen .field-list-child,
MeshRoleFormScreen .field-list-child, ModifiersFormScreen .field-list-child {
    padding-left: 2;
}

/* The row cursor (FieldList cursor=True); stronger while the list has focus. */
ArmatureFormScreen .field-list-highlighted,
MeshRolesFormScreen .field-list-highlighted,
MeshRoleFormScreen .field-list-highlighted,
ModifiersFormScreen .field-list-highlighted {
    background: $boost;
}

ArmatureFormScreen .field-list:focus .field-list-highlighted,
MeshRolesFormScreen .field-list:focus .field-list-highlighted,
MeshRoleFormScreen .field-list:focus .field-list-highlighted,
ModifiersFormScreen .field-list:focus .field-list-highlighted {
    background: $accent 30%;
}

/* Rows flagged as a problem (FieldList.marked): a rename left them unmatched,
   or a required field is missing. */
ArmatureFormScreen .field-list-marked, MeshRolesFormScreen .field-list-marked,
MeshRoleFormScreen .field-list-marked {
    background: $error-muted;
    color: $text-error;
}
