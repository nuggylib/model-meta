/* Application-level styles for Model Meta. */

.body {
    margin: 0 1 1 1;
    padding: 0 1 0 0;
}

.layout-heading-content {
    margin: 1 1 0 1;
    padding: 0 1 0 0;
    border-bottom: solid $secondary;
}

/* Keeps its top margin as the gap under the Header. */
.layout-heading-content:empty {
    border-bottom: none;
}

.layout-heading-content > * {
    margin-bottom: 1;
}

.options-list-container > * {
    margin-bottom: 1;
}

.options-list-container OptionList {
    height: 11;  /* 5 options + 4 separators + 2 border */
}

.section-heading {
    width: 100%;
    background: $primary;
    padding-left: 1;
    margin-bottom: 1;
}

.h2 {
    text-style: bold;
    color: #000000;
}

.config-value {
    width: 100%;
}

.config-detail {
    color: $text-muted;
}

.description {
    color: $text-muted;
    margin-bottom: 1;
}

/* Takes the rest of a horizontal row, its text against the right end. */
.align-right {
    width: 1fr;
    text-align: right;
    padding-right: 1;
}

.field-label {
    width: auto;
    margin-right: 1;
}

.column-heading {
    text-style: bold;
    margin-bottom: 1;
}

.fixes-panel {
    background: $panel;
    padding: 1 2 1 2;
    height: 12;
}

/* The header row plus 11 checks; the rest scroll beneath it. */
.armature-checks {
    max-height: 12;
}

.section-progress-bar {
    margin-bottom: 1;
}

.nested-progress-items {
    padding-left: 2;
}

.progress-summary {
    margin-top: 1;
}


.progress-summary > *,
.nested-progress-items > * {
    margin-bottom: 1;
}

Reports > * {
    margin-bottom: 1;
}

Header {
    background: $primary;
    color: #000000;
}

Tabs:focus Tab.-active {
    background: $accent;
}

OptionList {
    border: tall $panel;
}

OptionList:focus {
    border: tall $accent;
}

OptionList:focus > .option-list--option-highlighted {
    background: $panel 50%;
    color: $accent
}

Collapsible {
    background: $background;
}

/* Textual's default is 1 0 0 3; a lone padding-right would zero the other sides. */
Collapsible Contents {
    padding: 1 1 0 3;
}

Collapsible Contents > * {
    margin-bottom: 1;
}

CollapsibleTitle,
CollapsibleTitle:hover,
CollapsibleTitle:focus {
    background: transparent;
    color: $accent;
}

Button.-primary:focus {
    border: tall #FFFFFF;
}

* {
    scrollbar-color: #FFFFFF 50%;
    scrollbar-size-vertical: 1;
}

HorizontalGroup {
    width: 100%;
    height: auto;
}

/* Equal-width children with a 5-column gap between them. */
.columns > * {
    width: 1fr;
    margin-right: 5;
}

.columns > *:last-child {
    margin-right: 0;
}

/* Textual's Bar defaults to a fixed 32 columns. */
ProgressBar {
    width: 100%;
}

ProgressBar Bar {
    width: 1fr;
}

/* The unfilled part is drawn in the background color. */
ProgressBar Bar > .bar--bar {
    color: $secondary;
    background: $secondary 30%;
}

/* Warnings still count toward 100%, so the bar only turns green without them. */
ProgressBar.-warned Bar > .bar--complete {
    color: $secondary;
}

ProgressBar #percentage {
    color: $accent;
}

ProgressBar.-passed #percentage {
    color: $success;
}

/* The rail is painted on every row and only its color changes, keeping the text
   from shifting sideways as focus moves, as on the dashboard's cards. */
SelectableRow {
    width: 100%;
    height: auto;
    border-left: thick $panel;
    padding-left: 1;
}

SelectableRow:focus {
    border-left: thick $accent;
    background: $boost;
}

/* A sibling of its page's 1fr scroller, not docked: a docked container with auto
   height renders at one row. Capped so it can't crowd out the list. */
FixPanel {
    width: 100%;
    height: auto;
    max-height: 50%;
    padding: 0 2;
    border-top: solid $panel;
}

FixPanel .fix-step {
    width: 100%;
    height: auto;
}

/* Shown in place of the sections when there is no valid config. */
#setup-prompt {
    width: auto;
    padding: 1 2;
}

/* -- dashboard ----------------------------------------------------------- */

/* A top-aligned column of config sections (Specs → Models → Godot), not a
   single centered line. */
DashboardScreen #config-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}
DashboardScreen #config-panel > * {
    margin-bottom: 1;
}
DashboardScreen #config-panel > :last-child {
    margin-bottom: 0;
}

/* -- detail screens ------------------------------------------------------ */

#detail-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Sets the placeholder note apart from the values above it. */
#placeholder-note {
    margin-top: 1;
}

/* -- model report screen ------------------------------------------------- */

ModelReportScreen #model-header {
    height: auto;
    margin-bottom: 1;
}

ModelReportScreen #model-heading {
    height: auto;
}

ModelReportScreen #model-title {
    width: auto;
}

/* Root rows are SelectableRows: rail, padding and "▸ " put their text 4 columns
   in, so nested rows start there too. */
ModelReportScreen .model-item-depth-1 {
    padding-left: 7;
}

ModelReportScreen .model-item-depth-2 {
    padding-left: 10;
}

/* -- check detail screen ------------------------------------------------- */

CheckDetailScreen #check-title {
    padding: 1 2 0 2;
}

CheckDetailScreen #check-lines {
    height: 1fr;
    padding: 1 2;
}

/* One box per check or field (a mesh role's, or armature alone); the key sits in
   the border. */
CheckDetailScreen .check-section {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 1;
    border: round $panel;
    border-title-color: $accent;
}

/* A section's blocks (facts, a warning, help, rows, one check's fixes) sit a blank
   line apart; `spaced` is every block after the first. */
CheckDetailScreen .check-block {
    height: auto;
}

CheckDetailScreen .check-block.spaced {
    margin-top: 1;
}

/* The page's fixes, above its checks: each check's label, then its numbered fixes. */
CheckDetailScreen .check-fixes {
    border: round $warning;
}

CheckDetailScreen .fix-label {
    text-style: bold;
}

CheckDetailScreen .fix-item {
    padding-left: 2;
}

CheckDetailScreen .check-warning {
    color: $warning;
}

/* -- spec detail screen -------------------------------------------------- */

/* One box per spec root field (FieldSummary); the field name sits in the border. */
SpecDetailScreen #spec-title {
    margin-bottom: 1;
}

SpecDetailScreen .field-summary {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

SpecDetailScreen .field-row-child {
    padding-left: 2;
}

/* Item lists (e.g. mesh role names) wrap into side-by-side columns. */
SpecDetailScreen .field-columns {
    height: auto;
}

SpecDetailScreen .field-column {
    width: auto;
    height: auto;
    margin-right: 4;
}

SpecDetailScreen .field-item {
    width: auto;
}

SpecDetailScreen .field-empty {
    color: $text-muted;
}

/* -- Specs screen -------------------------------------------------------- */

SpecsScreen #specs-summary,
SpecsScreen #specs-empty {
    margin-bottom: 1;
}

/* The spec list scrolls; `height: 1fr` gives it whatever is left between the
   header, the fix block, and the footer. `can_focus=False` on the container
   (set in Python) keeps it out of the row focus chain. */
SpecsScreen #detail-panel {
    height: 1fr;
}

/* -- armature, mesh-roles, mesh-role and modifiers forms ----------------- */

/* One box per field (FieldList); the border turns accent when it's selected. */
ArmatureFormScreen .field-list, MeshRolesFormScreen .field-list,
MeshRoleFormScreen .field-list, ModifiersFormScreen .field-list {
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

ArmatureFormScreen .field-list:focus, MeshRolesFormScreen .field-list:focus,
MeshRoleFormScreen .field-list:focus, ModifiersFormScreen .field-list:focus {
    border: round $accent;
}

ArmatureFormScreen .field-list-child, MeshRolesFormScreen .field-list-child,
MeshRoleFormScreen .field-list-child, ModifiersFormScreen .field-list-child {
    padding-left: 2;
}

/* The row cursor (FieldList cursor=True); stronger while the list has focus. */
ArmatureFormScreen .field-list-highlighted,
MeshRolesFormScreen .field-list-highlighted,
MeshRoleFormScreen .field-list-highlighted,
ModifiersFormScreen .field-list-highlighted {
    background: $boost;
}

ArmatureFormScreen .field-list:focus .field-list-highlighted,
MeshRolesFormScreen .field-list:focus .field-list-highlighted,
MeshRoleFormScreen .field-list:focus .field-list-highlighted,
ModifiersFormScreen .field-list:focus .field-list-highlighted {
    background: $accent 30%;
}

/* Rows flagged as a problem (FieldList.marked): a rename left them unmatched,
   or a required field is missing. */
ArmatureFormScreen .field-list-marked, MeshRolesFormScreen .field-list-marked,
MeshRoleFormScreen .field-list-marked {
    background: $error-muted;
    color: $text-error;
}
